datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =========================================================
// PLATFORM & SAAS LAYER
// =========================================================

enum TenantStatus {
  PENDING_APPROVAL
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum MemberRole {
  INSTITUTE_ADMIN
  OFFICER_IN_CHARGE
  DATA_ENTRY
  SUPERVISOR
  PRINCIPAL
  BILLING
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

model Plan {
  id                      String      @id @default(cuid())
  name                    String      @unique // Trial, Standard, Enterprise
  maxCandidatesPerSession Int         @default(1500)
  modulesEnabled          Json        // ["THEORY_CORE", "SUPERVISION", "PRACTICALS", "RESULTS"]
  priceInr                Int         @default(0)
  createdAt               DateTime    @default(now())

  institutes              Institute[]
}

model Institute {
  id                String       @id @default(cuid())
  code              String       @unique // Institute code e.g. "0018", "1227"
  examCentreCode    String?      // Exam Centre Code e.g. "1227", "9999"
  name              String
  nameUpper         String?      // Verbatim uppercase name for Bench Arrangement & Gate Chart
  nameTitleCase     String?      // Verbatim title-case name for Supervisor Report
  region            String       // Pune, Mumbai, Nagpur, Chh. Sambhaji Nagar
  regionCode        String       @default("5002")
  address           String
  logoUrl           String?
  principalName     String?
  contactPerson     String?
  contactPhone      String?
  contactEmail      String?
  dcCode            String       @default("0710")
  dcName            String?
  oicFullName       String?
  oicShortName      String?
  oicPhone          String?
  morningOpenTime   String       @default("09:10 AM")
  afternoonOpenTime String       @default("01:40 PM")
  receiptTime       String       @default("08:15 AM")
  planId            String?
  status            TenantStatus @default(PENDING_APPROVAL)
  trialEndsAt       DateTime?
  validUntil        DateTime?
  isDemo            Boolean      @default(false)
  dpaAcceptedAt     DateTime?
  dpaAcceptedBy     String?
  retentionMonths   Int          @default(12)
  onboardingDone    Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  plan              Plan?        @relation(fields: [planId], references: [id])
  memberships       Membership[]
  invoices          Invoice[]
  importTemplates   ImportTemplate[]
  auditLogs         AuditLog[]
  impersonations    ImpersonationLog[]
  sessions          ExamSession[]
  schemes           Scheme[]
  subjects          Subject[]
  rooms             Room[]
  blocks            Block[]
  staff             Staff[]
  specialCodes      SpecialCode[]
  reportTemplates   ReportTemplate[]
  generatedReports  GeneratedReport[]
  remunerationRates RemunerationRate[]
}

model User {
  id             String             @id @default(cuid())
  supabaseUid    String?            @unique
  email          String             @unique
  passwordHash   String?
  name           String
  phone          String?
  isSuperAdmin   Boolean            @default(false)
  createdAt      DateTime           @default(now())

  memberships    Membership[]
  auditLogs      AuditLog[]
  impersonations ImpersonationLog[]
}

model Membership {
  id          String     @id @default(cuid())
  instituteId String
  userId      String
  role        MemberRole @default(SUPERVISOR)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  institute   Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([instituteId, userId])
  @@index([instituteId])
}

model Invoice {
  id            String        @id @default(cuid())
  instituteId   String
  invoiceNumber String        @unique
  companyName   String        @default("ExamOps Technologies")
  amountInr     Int
  gstInr        Int
  totalInr      Int
  status        InvoiceStatus @default(SENT)
  issuedAt      DateTime      @default(now())
  paidAt        DateTime?
  notes         String?

  institute     Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
}

model ImpersonationLog {
  id           String    @id @default(cuid())
  superAdminId String
  instituteId  String
  reason       String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  superAdmin   User      @relation(fields: [superAdminId], references: [id])
  institute    Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
}

model IncidentLog {
  id          String    @id @default(cuid())
  title       String
  severity    String    // LOW, MEDIUM, HIGH, CRITICAL
  description String
  status      String    @default("OPEN") // OPEN, CONTAINED, RESOLVED
  reportedAt  DateTime  @default(now())
  resolvedAt  DateTime?
}

model AuditLog {
  id          String    @id @default(cuid())
  instituteId String
  userId      String?
  action      String
  entity      String
  entityId    String?
  reason      String?
  beforeData  Json?
  afterData   Json?
  createdAt   DateTime  @default(now())

  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id])

  @@index([instituteId, createdAt])
}

// =========================================================
// EXAM CENTRE MASTERS & IMPORTS
// =========================================================

enum ImportSourceType {
  TIMETABLE
  QP_INVENTORY
  SEATING_CHART
  MARKSHEET
}

enum SessionSlot {
  MORNING
  AFTERNOON
}

enum NumberingStyle {
  SERPENTINE
  STRAIGHT
}

model ImportTemplate {
  id            String           @id @default(cuid())
  instituteId   String
  sourceType    ImportSourceType
  name          String
  columnMapping Json             // { "seatNo": "Seat_No", "csm": "C-S-M", ... }
  createdAt     DateTime         @default(now())

  institute     Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([instituteId, sourceType, name])
}

model ExamSession {
  id                     String             @id @default(cuid())
  instituteId            String
  name                   String             // "Winter-2026"
  code                   String             // "W26"
  practicalStartDate     DateTime?
  practicalEndDate       DateTime?
  sem1PracticalStartDate DateTime?
  sem1PracticalEndDate   DateTime?
  theoryStartDate        DateTime
  theoryEndDate          DateTime
  status                 String             @default("ACTIVE") // DRAFT, ACTIVE, LOCKED, ARCHIVED
  lockedAt               DateTime?
  lockedById             String?
  purgedAt               DateTime?
  createdAt              DateTime           @default(now())

  institute              Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  timetableEntries       TimetableEntry[]
  candidates             Candidate[]
  blockAllocations       BlockAllocation[]
  blockSubmissions       BlockSubmission[]
  supervisionDuties      SupervisionDuty[]
  answerBookRecords      AnswerBookRecord[]
  earlyLeavings          EarlyLeaving[]
  marksheetRecords       MarksheetRecord[]

  @@unique([instituteId, code])
  @@index([instituteId])
}

model Scheme {
  id          String    @id @default(cuid())
  instituteId String
  name        String    // "K", "I"
  isActive    Boolean   @default(true)

  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  subjects    Subject[]

  @@unique([instituteId, name])
}

model Subject {
  id           String           @id @default(cuid())
  instituteId  String
  schemeId     String
  code         String           // "313303", "22516"
  name         String           // "DIGITAL TECHNIQUES"
  abbreviation String           // "DTE"
  hasSections  Boolean          @default(false) // Section I & II -> 2 main answer books

  institute    Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  scheme       Scheme           @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  timetable    TimetableEntry[]

  @@unique([instituteId, schemeId, code])
}

model TimetableEntry {
  id          String           @id @default(cuid())
  instituteId String
  sessionId   String
  subjectId   String
  examDay     Int              // 1, 2, ... 18
  examDate    DateTime         @db.Date
  slot        SessionSlot      // MORNING / AFTERNOON
  timeRange   String           // "02:00 P.M. to 05:00 P.M."
  csm         String           // "CO-3-K"

  session     ExamSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  papers      CandidatePaper[]
  qpInventory QPInventory?

  @@unique([sessionId, examDay, slot, subjectId, csm])
  @@index([instituteId, sessionId, examDay, slot])
}

model Candidate {
  id           String           @id @default(cuid())
  instituteId  String
  sessionId    String
  seatNo       String
  enrollmentNo String?
  name         String?
  instCode     String           // Candidate's own institute code (e.g. 1227 or visiting)
  csm          String           // "CO-3-K"
  isDetained   Boolean          @default(false)

  session      ExamSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  papers       CandidatePaper[]

  @@unique([sessionId, seatNo])
  @@index([instituteId, sessionId])
}

model CandidatePaper {
  id               String            @id @default(cuid())
  instituteId      String
  candidateId      String
  timetableEntryId String
  isDetained       Boolean           @default(false)

  candidate        Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  timetableEntry   TimetableEntry    @relation(fields: [timetableEntryId], references: [id], onDelete: Cascade)
  allocations      BlockAllocation[]
  statuses         CandidateStatus[]
  copyCases        CopyCase[]

  @@unique([candidateId, timetableEntryId])
  @@index([instituteId, timetableEntryId])
}

model QPInventory {
  id               String         @id @default(cuid())
  instituteId      String
  timetableEntryId String         @unique
  dcCode           String         // Distribution Centre Code
  ecCode           String         // Exam Centre Code
  qpCount          Int            // Portal QP inventory count
  receivedCount    Int?           // Recorded at exam day
  usedCount        Int?
  returnedCount    Int?
  extraCount       Int?
  lessCount        Int?

  timetableEntry   TimetableEntry @relation(fields: [timetableEntryId], references: [id], onDelete: Cascade)

  @@index([instituteId])
}

model Room {
  id          String    @id @default(cuid())
  instituteId String
  roomNo      String    // "F-11"
  building    String    @default("Main Building")
  floor       Int       @default(1)

  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  blocks      Block[]

  @@unique([instituteId, roomNo])
}

model Block {
  id             String             @id @default(cuid())
  instituteId    String
  blockNo        Int                // 1, 2, ... 8
  roomId         String
  benchLabel     String?            // e.g. "-G 09 DH-1"
  gateLocation   String?            // e.g. "G09-DH1"
  shortRoom      String?            // e.g. "G09"
  columns        Int                @default(4) // e.g. 4
  columnBreak    Int                @default(9) // e.g. 9 -> strength = 36
  strength       Int                @default(36)
  numberingStyle NumberingStyle     @default(SERPENTINE)

  institute      Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  room           Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allocations    BlockAllocation[]
  submissions    BlockSubmission[]
  duties         SupervisionDuty[]
  answerBooks    AnswerBookRecord[]

  @@unique([instituteId, blockNo])
}

model BlockAllocation {
  id               String         @id @default(cuid())
  instituteId      String
  sessionId        String
  examDay          Int
  slot             SessionSlot
  blockId          String
  candidatePaperId String
  benchNo          Int            // 1..36
  columnNo         Int            // 1..4
  rowNo            Int            // 1..9
  version          Int            @default(1)
  isLocked         Boolean        @default(false)

  session          ExamSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  block            Block          @relation(fields: [blockId], references: [id], onDelete: Cascade)
  candidatePaper   CandidatePaper @relation(fields: [candidatePaperId], references: [id], onDelete: Cascade)

  @@unique([sessionId, examDay, slot, candidatePaperId])
  @@unique([sessionId, examDay, slot, blockId, benchNo])
  @@index([instituteId, sessionId, examDay, slot])
}

// =========================================================
// EXAM DAY, SPECIAL CODES & SUPPORTING RECORDS
// =========================================================

model SpecialCode {
  id          String            @id @default(cuid())
  instituteId String
  code        String            // "AB", "DET", "CC"
  label       String            // "Absent", "Detained", "Copy Case"

  institute   Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  statuses    CandidateStatus[]

  @@unique([instituteId, code])
}

model CandidateStatus {
  id                String         @id @default(cuid())
  instituteId       String
  candidatePaperId  String
  specialCodeId     String
  section           Int            @default(1) // 1 or 2 for Section I/II subjects
  mainBookSerial    String?
  supplementSerials String?
  remark            String?
  markedById        String?
  markedAt          DateTime       @default(now())

  candidatePaper    CandidatePaper @relation(fields: [candidatePaperId], references: [id], onDelete: Cascade)
  specialCode       SpecialCode    @relation(fields: [specialCodeId], references: [id])

  @@unique([candidatePaperId, section])
  @@index([instituteId])
}

model BlockSubmission {
  id            String      @id @default(cuid())
  instituteId   String
  sessionId     String
  examDay       Int
  slot          SessionSlot
  blockId       String
  isSubmitted   Boolean     @default(false)
  submittedById String?
  submittedAt   DateTime?

  session       ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  block         Block       @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([sessionId, examDay, slot, blockId])
}

model AnswerBookRecord {
  id                 String      @id @default(cuid())
  instituteId        String
  sessionId          String
  examDay            Int
  slot               SessionSlot
  blockId            String
  mainProvided       Int         @default(0)
  mainUsed           Int         @default(0)
  suppProvided       Int         @default(0)
  suppUsed           Int         @default(0)
  drawingProvided    Int         @default(0)
  drawingUsed        Int         @default(0)
  graphProvided      Int         @default(0)
  graphUsed          Int         @default(0)
  controllerSignedBy String?
  supervisorSignedBy String?

  session            ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  block              Block       @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([sessionId, examDay, slot, blockId])
}

model EarlyLeaving {
  id           String      @id @default(cuid())
  instituteId  String
  sessionId    String
  examDay      Int
  slot         SessionSlot
  seatNo       String
  csm          String
  timeOut      String
  supervisorId String?

  session      ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([instituteId, sessionId])
}

model CopyCase {
  id                  String         @id @default(cuid())
  instituteId         String
  candidatePaperId    String
  reportedTime        String
  materialSeized      String
  supervisorStatement String
  oicSignedBy         String?
  createdAt           DateTime       @default(now())

  candidatePaper      CandidatePaper @relation(fields: [candidatePaperId], references: [id], onDelete: Cascade)

  @@index([instituteId])
}

model MarksheetRecord {
  id          String      @id @default(cuid())
  instituteId String
  sessionId   String
  seatNo      String
  subjectCode String
  marksheetNo String
  marks       Int?
  status      String?

  session     ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([instituteId, sessionId, seatNo])
}

// =========================================================
// SUPERVISION & REMUNERATION
// =========================================================

model Staff {
  id                  String            @id @default(cuid())
  instituteId         String
  name                String
  designation         String
  department          String
  type                String            @default("TEACHING") // TEACHING, LAB_ASSISTANT, PEON
  subjectsTaught      String[]
  maxDutiesPerSession Int               @default(10)
  unavailableDates    String[]          // YYYY-MM-DD
  email               String?
  phone               String?

  institute           Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  duties              SupervisionDuty[]
  swapsRequested      DutySwapRequest[] @relation("SwapRequester")
  swapsTargeted       DutySwapRequest[] @relation("SwapTarget")

  @@index([instituteId])
}

model SupervisionDuty {
  id           String            @id @default(cuid())
  instituteId  String
  sessionId    String
  examDay      Int
  examDate     DateTime          @db.Date
  slot         SessionSlot
  blockId      String?
  staffId      String
  role         String            // JUNIOR, RELIEVER, SENIOR
  version      Int               @default(1)
  isOverride   Boolean           @default(false)

  session      ExamSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  block        Block?            @relation(fields: [blockId], references: [id])
  staff        Staff             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  swapRequests DutySwapRequest[]

  @@unique([sessionId, examDay, slot, staffId])
  @@index([instituteId, sessionId])
}

model DutySwapRequest {
  id               String          @id @default(cuid())
  instituteId      String
  dutyId           String
  requesterStaffId String
  targetStaffId    String
  reason           String
  status           String          @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedAt       DateTime?

  duty             SupervisionDuty @relation(fields: [dutyId], references: [id], onDelete: Cascade)
  requester        Staff           @relation("SwapRequester", fields: [requesterStaffId], references: [id])
  target           Staff           @relation("SwapTarget", fields: [targetStaffId], references: [id])
}

model RemunerationRate {
  id          String    @id @default(cuid())
  instituteId String
  role        String    // JUNIOR, RELIEVER, SENIOR, INTERNAL_PR, EXTERNAL_PR
  ratePerDuty Int

  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([instituteId, role])
}

// =========================================================
// TEMPLATE-DRIVEN REPORTS
// =========================================================

model ReportTemplate {
  id          String    @id @default(cuid())
  instituteId String
  key         String    // BENCH_ARRANGEMENT, GATE_CHART, ATTENDANCE, ANNEXURE_F, FORMAT_03, FORMAT_7, etc.
  title       String
  version     Int       @default(1)
  html        String    @db.Text
  css         String?   @db.Text
  docxBase64  String?   @db.Text
  isActive    Boolean   @default(true)
  updatedAt   DateTime  @updatedAt

  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([instituteId, key, version])
}

model GeneratedReport {
  id          String    @id @default(cuid())
  instituteId String
  templateKey String
  params      Json
  fileUrl     String
  createdById String?
  createdAt   DateTime  @default(now())

  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId, createdAt])
}

// =========================================================
// SECTION 7: PRACTICALS, CLASS TESTS & RESULTS
// =========================================================

model Examiner {
  id            String          @id @default(cuid())
  instituteId   String
  name          String
  designation   String
  instituteName String
  phone         String?
  email         String?
  subjectCode   String
  type          String          @default("EXTERNAL") // EXTERNAL, INTERNAL
  createdAt     DateTime        @default(now())

  internalSlots PracticalSlot[] @relation("InternalExaminer")
  externalSlots PracticalSlot[] @relation("ExternalExaminer")

  @@index([instituteId])
}

model PracticalSlot {
  id                 String    @id @default(cuid())
  instituteId        String
  sessionId          String
  csm                String
  subjectCode        String
  batchName          String
  labName            String
  examDate           DateTime  @db.Date
  timeSlot           String    // e.g. "10:00 AM - 12:00 PM"
  internalExaminerId String?
  externalExaminerId String?
  createdAt          DateTime  @default(now())

  internalExaminer   Examiner? @relation("InternalExaminer", fields: [internalExaminerId], references: [id])
  externalExaminer   Examiner? @relation("ExternalExaminer", fields: [externalExaminerId], references: [id])

  @@index([instituteId, sessionId, examDate])
}

model ClassTestMark {
  id            String   @id @default(cuid())
  instituteId   String
  sessionId     String
  csm           String
  subjectCode   String
  seatNo        String
  ct1Marks      Int?
  ct2Marks      Int?
  ct1Absent     Boolean  @default(false)
  ct2Absent     Boolean  @default(false)
  faThAvg       Float    @default(0)
  attendancePct Float    @default(100)
  isDetained    Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@unique([sessionId, subjectCode, seatNo])
  @@index([instituteId, sessionId])
}

model ResultRecord {
  id          String   @id @default(cuid())
  instituteId String
  sessionId   String
  seatNo      String
  csm         String
  subjectCode String
  marks       Int
  maxMarks    Int      @default(100)
  status      String   // PASS, FAIL, ATKT
  createdAt   DateTime @default(now())

  @@unique([sessionId, subjectCode, seatNo])
  @@index([instituteId, sessionId])
}

model DayReceipt {
  id                String   @id @default(cuid())
  instituteId       String
  sessionId         String
  examDay           Int
  controllerName    String
  morningOpenTime   String   @default("09:10 AM")
  afternoonOpenTime String   @default("01:40 PM")
  receiptTime       String   @default("08:15 AM")
  actualRowsJson    Json?
  updatedAt         DateTime @updatedAt

  @@unique([sessionId, examDay])
  @@index([instituteId, sessionId])
}
